# Hosted Neon Lakebase Postgres (project `falling-cherry-16443194`):
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Master secret (32+ random characters) for per-user HKDF-SHA256 + AES-256-GCM encryption of API keys:
# Generate with: openssl rand -base64 32
LM_SUBS_ENCRYPTION_SECRET=""

# Hosted User Sign-In Providers (Google OAuth, GitHub OAuth, and Email 6-digit codes):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
RESEND_API_KEY=""
AUTH_FROM_EMAIL="LM Subs <signin@yourdomain.com>"

# Optional Neon Managed Auth JWKS (if also verifying Neon Auth JWTs):
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""

# Admin dashboard access. Comma separated list of account email addresses that
# may open /admin and read the download counters. Keep this in Vercel only:
# never commit a real address to the repository.
LM_SUBS_ADMIN_EMAILS=""
