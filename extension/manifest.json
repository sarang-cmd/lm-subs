{
  "manifest_version": 3,
  "name": "LM Subs",
  "short_name": "LM Subs",
  "version": "0.2.1",
  "description": "Sub-5s synchronized captions, .SRT/.VTT/.TXT/.JSON export & encrypted Neon Postgres sync for Google NotebookLM Video Overviews.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LM Subs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "optional_permissions": ["notifications"],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*",
    "https://notebook.cloud.google.com/*",
    "https://lh3.googleusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.google.com/*",
    "https://*.googlevideo.com/*",
    "https://*.gvt1.com/*",
    "https://*.ggpht.com/*",
    "https://*.google.com/*",
    "https://api.groq.com/*",
    "https://api.mistral.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepgram.com/*",
    "https://api.assemblyai.com/*",
    "https://api.gladia.io/*",
    "https://api.cloudflare.com/*",
    "https://api.elevenlabs.io/*",
    "https://router.huggingface.co/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://lm-subs.vercel.app/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*",
        "https://notebook.cloud.google.com/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*",
        "https://notebook.cloud.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
