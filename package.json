{
  "name": "lm-subs",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "LM Subs: Synchronized captions, .SRT/.VTT/.TXT/.JSON export, 12-provider BYOK speech-to-text, and hosted encrypted Neon Postgres sync for Google NotebookLM Video Overviews.",
  "keywords": [
    "lm-subs",
    "notebooklm",
    "google-notebooklm",
    "subtitles",
    "captions",
    "srt",
    "webvtt",
    "transcript-export",
    "chrome-extension",
    "manifest-v3",
    "speech-to-text",
    "whisper",
    "groq",
    "mistral",
    "neon",
    "postgresql",
    "byok"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sarang-cmd/notebooklm-subtitles.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node serve-docs.mjs",
    "site": "node serve-docs.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "test": "node --test tests/*.test.js",
    "assets": "node scripts/generate-assets.mjs",
    "zip": "node build.mjs && node scripts/package-zip.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neon/functions": "^0.11.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "motion": "^14.6.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
